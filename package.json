{
  "name": "orchestrator-token-coupon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @token-coupon/core && npm run build --workspace @token-coupon/cli",
    "typecheck": "npm run build --workspace @token-coupon/core && npm run typecheck --workspace @token-coupon/core && npm run typecheck --workspace @token-coupon/cli",
    "cli": "npm run build && node packages/cli/dist/main.js",
    "demo:phase3.5": "npm run build && node scripts/phase3.5-demo.mjs",
    "demo:phase3.5-bugfix": "npm run build && node scripts/phase3.5-bugfix-demo.mjs",
    "demo:phase3.5-bugfix-2": "npm run build && node scripts/phase3.5-bugfix-2-demo.mjs",
    "demo:phase3.5-bugfix-3": "npm run build && node scripts/phase3.5-bugfix-3-demo.mjs",
    "demo:phase3.5-bugfix-4": "npm run build && node scripts/phase3.5-bugfix-4-demo.mjs",
    "demo:phase3.5-bugfix-5": "npm run build && node scripts/phase3.5-bugfix-5-demo.mjs",
    "test": "npm run build && vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.1.0",
    "vitest": "^5.0.3"
  }
}
